CREATE DATABASE sits;
USE sits;

CREATE TABLE employees (
    Employee_ID INT PRIMARY KEY,
    Name VARCHAR(100),
    Department VARCHAR(50),
    Salary DECIMAL(10,2),
    Bonus DECIMAL(10,2),
    Join_Date DATE,
    Location VARCHAR(50),
    Performance_Score INT,
    Manager_ID INT,
    Status VARCHAR(20)
);

